---
const steps = [
	{ num: '01', title: 'Prise de contact', text: 'Nous écrivons aux dirigeants du pays.' },
	{ num: '02', title: 'Présentation', text: 'Nous leur montrons la machine et son fonctionnement.' },
	{ num: '03', title: 'Décision du pays', text: "Les dirigeants choisissent d'accueillir ou non l'invention.", key: true },
	{ num: '04', title: 'Installation', text: 'La machine est installée et commence à produire.' },
];
---

<section id="deploiement" class="deploiement">
	<svg class="wave" viewBox="0 0 1440 260" preserveAspectRatio="none" aria-hidden="true">
		<defs>
			<linearGradient id="wvG" x1="0" y1="0" x2="1" y2="0">
				<stop offset="0" stop-color="#2E5BFF" stop-opacity="0"></stop>
				<stop offset="0.35" stop-color="#3DE0FF"></stop>
				<stop offset="0.7" stop-color="#7FA2FF"></stop>
				<stop offset="1" stop-color="#2E5BFF" stop-opacity="0"></stop>
			</linearGradient>
			<filter id="wvBlur" x="-10%" y="-100%" width="120%" height="300%"><feGaussianBlur stdDeviation="9"></feGaussianBlur></filter>
		</defs>
		<path d="M0 170 C 240 170, 380 220, 560 200 C 760 178, 820 60, 1000 60 C 1180 60, 1240 160, 1440 150" fill="none" stroke="#2E5BFF" stroke-width="14" opacity="0.8" filter="url(#wvBlur)"></path>
		<path d="M0 170 C 240 170, 380 220, 560 200 C 760 178, 820 60, 1000 60 C 1180 60, 1240 160, 1440 150" fill="none" stroke="url(#wvG)" stroke-width="2.5"></path>
	</svg>

	<div class="deploiement__inner container">
		<div class="deploiement__head">
			<p class="label">[ 03 ] Déploiement</p>
			<h2 class="title">Aucune machine sans <span class="gradient-text">l'accord du pays</span></h2>
			<p class="lead">
				Avant chaque installation, nous rencontrons les dirigeants et leur présentons l'invention.
				Ce sont eux qui décident de l'accueillir.
			</p>
		</div>

		<ol class="timeline">
			{steps.map((step) => (
				<li class:list={['tl-card', { 'tl-card--key': step.key }]}>
					<div class="tl-card__meta">
						<span class="tl-card__dot" aria-hidden="true"></span>
						<span>Étape {step.num}{step.key && ' — clé'}</span>
					</div>
					<h3>{step.title}</h3>
					<p>{step.text}</p>
				</li>
			))}
		</ol>

		<form class="newsletter" action="#" method="post">
			<p class="newsletter__text">&gt; Recevez les nouvelles du projet</p>
			<div class="newsletter__fields">
				<label for="news-email" class="sr-only">Adresse e-mail</label>
				<input id="news-email" name="email" type="email" placeholder="votre@email.com" autocomplete="email" required />
				<button type="submit" class="btn btn--light">S'inscrire</button>
			</div>
		</form>
	</div>
</section>

<style>
	.deploiement {
		position: relative;
	}

	.wave {
		display: block;
		width: 100%;
		height: 220px;
	}

	.deploiement__inner {
		display: flex;
		flex-direction: column;
		gap: 56px;
		padding-top: 24px;
		padding-bottom: 120px;
	}

	.deploiement__head {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
		text-align: center;
	}

	.deploiement__head .title {
		max-width: 900px;
	}

	.deploiement__head .lead {
		max-width: 620px;
	}

	.timeline {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tl-card {
		flex: 1 1 250px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 26px;
		border-radius: 24px;
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.tl-card__meta {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--label);
	}

	.tl-card__dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 2px solid var(--blue-light);
	}

	.tl-card h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 20px;
	}

	.tl-card p {
		margin: 0;
		font-size: 15px;
		color: var(--muted);
	}

	.tl-card--key {
		border-color: rgba(127, 162, 255, 0.7);
		background: linear-gradient(160deg, var(--blue), #12227a);
		box-shadow: 0 20px 60px rgba(46, 91, 255, 0.45);
	}

	.tl-card--key .tl-card__meta {
		color: var(--text);
	}

	.tl-card--key .tl-card__dot {
		border: 0;
		background: var(--cyan);
		box-shadow: 0 0 10px var(--cyan);
	}

	.tl-card--key p {
		color: #e3e9ff;
	}

	.newsletter {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 14px 24px;
		padding: 10px 10px 10px 30px;
		border-radius: 999px;
		border: 1px solid rgba(127, 162, 255, 0.28);
		background: rgba(255, 255, 255, 0.04);
	}

	.newsletter__text {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.newsletter__fields {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.newsletter input {
		width: 280px;
		max-width: 100%;
		min-height: 48px;
		padding: 0 20px;
		border-radius: 999px;
		border: 1px solid rgba(127, 162, 255, 0.3);
		background: var(--bg);
		color: var(--text);
		font-size: 15px;
	}

	.newsletter input::placeholder {
		color: #7d88ad;
	}

	.newsletter .btn {
		min-height: 48px;
		padding: 0 24px;
		font-size: 15px;
	}

	@media (max-width: 640px) {
		.newsletter {
			border-radius: 24px;
			padding: 20px;
		}
		.newsletter__fields,
		.newsletter input {
			width: 100%;
		}
	}
</style>
