---
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer__inner container">
		<span class="footer__logo">FAIM/ZÉRO</span>
		<span>Un projet de Katerina, Lizaveta et Piotr Petrovitch</span>
		<span class="footer__note">Projet étudiant fictif</span>
	</div>
	<p class="footer__copy container">© {year} Faim Zéro</p>
</footer>

<style>
	.footer {
		border-top: 1px solid rgba(127, 162, 255, 0.18);
		background: linear-gradient(180deg, var(--bg), #0a1240);
		color: var(--muted);
		font-size: 14px;
	}

	.footer__inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		padding-top: 48px;
		padding-bottom: 24px;
	}

	.footer__logo {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 18px;
		letter-spacing: 0.06em;
		color: var(--text);
	}

	.footer__note {
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text);
	}

	.footer__copy {
		margin-block: 0;
		padding-bottom: 40px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: #7d88ad;
	}
</style>
