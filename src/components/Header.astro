---
const links = [
	{ href: '#projet', label: 'Le projet' },
	{ href: '#machine', label: 'La machine' },
	{ href: '#deploiement', label: 'Déploiement' },
];
---

<header class="header">
	<nav class="header__nav container" aria-label="Navigation principale">
		<a href="#accueil" class="logo">
			<svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
				<rect x="2" y="2" width="30" height="30" rx="9" fill="none" stroke="#2E5BFF" stroke-width="2"></rect>
				<path d="M10 12 H24 L10 22 H24" fill="none" stroke="#F2F5FF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
			<span>FAIM/ZÉRO</span>
		</a>

		<ul class="pill">
			{links.map((link) => (
				<li><a href={link.href}>{link.label}</a></li>
			))}
		</ul>

		<a href="#contact" class="btn btn--light header__cta">
			Proposer mon pays
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
		</a>
	</nav>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(5, 7, 20, 0.6);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid transparent;
	}

	.header__nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 20px;
		padding-block: 20px;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 44px;
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 17px;
		letter-spacing: 0.06em;
	}

	.pill {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		margin: 0;
		padding: 5px;
		list-style: none;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(127, 162, 255, 0.2);
		font-size: 14px;
		font-weight: 500;
	}

	.pill a {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0 18px;
		border-radius: 999px;
		text-decoration: none;
		transition: background 0.2s ease;
	}

	.pill a:hover {
		background: rgba(127, 162, 255, 0.14);
	}

	.header__cta {
		min-height: 44px;
		padding: 0 22px;
		font-size: 14px;
	}

	@media (max-width: 860px) {
		.pill {
			order: 3;
			width: 100%;
			justify-content: center;
		}
	}
</style>
